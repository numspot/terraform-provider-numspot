{
	"datasources": [
		{
			"name": "kubernetes_nodepool",
			"schema": {
				"attributes": [
					{
						"name": "cluster_id",
						"string": {
							"computed_optional_required": "required",
							"description": "Identifier of the Cluster"
						}
					},
					{
						"name": "items",
						"list_nested": {
							"computed_optional_required": "computed",
							"nested_object": {
								"attributes": [
									{
										"name": "autoscaling_max",
										"int64": {
											"computed_optional_required": "computed",
											"description": "Maximum number of nodes for autoscaling. Present only when autoscaling is enabled."
										}
									},
									{
										"name": "autoscaling_min",
										"int64": {
											"computed_optional_required": "computed",
											"description": "Minimum number of nodes for autoscaling. Present only when autoscaling is enabled."
										}
									},
									{
										"name": "availability_zone",
										"string": {
											"computed_optional_required": "computed",
											"description": "List of all Availability Zones name."
										}
									},
									{
										"name": "id",
										"string": {
											"computed_optional_required": "computed",
											"description": "A string representing uuid."
										}
									},
									{
										"name": "node_profile",
										"string": {
											"computed_optional_required": "computed",
											"description": "Name of the worker node profile.\nOnly supported profiles are accepted; the value is validated at the API level.\nSupported values: small, medium, large, xlarge, gpu-xsmall, gpu-small,\ngpu-medium, gpu-large, gpu-xlarge.\nThis list is documentation only — the source of truth is the domain registry\n(internal/core/domain/node_pools.go, domain.NodeProfiles).\n"
										}
									},
									{
										"name": "replicas",
										"int64": {
											"computed_optional_required": "computed",
											"description": "Current number of replicas, sourced from the MachineDeployment status. Falls back to the creation parameter when the resource status is not yet available."
										}
									},
									{
										"name": "replicas_available",
										"int64": {
											"computed_optional_required": "computed",
											"description": "Current number of replicas in Available status, sourced from the MachineDeployment status. Reports 0 when the resource status is not yet available."
										}
									},
									{
										"name": "root_disk",
										"single_nested": {
											"computed_optional_required": "computed",
											"attributes": [
												{
													"name": "iops",
													"int64": {
														"computed_optional_required": "computed",
														"description": "The number of IOPS to allocate to the volume."
													}
												},
												{
													"name": "size",
													"int64": {
														"computed_optional_required": "computed",
														"description": "A volume size in GiB"
													}
												},
												{
													"name": "type",
													"string": {
														"computed_optional_required": "computed",
														"description": "Types of storage volumes available"
													}
												}
											]
										}
									},
									{
										"name": "status",
										"single_nested": {
											"computed_optional_required": "computed",
											"attributes": [
												{
													"name": "message",
													"string": {
														"computed_optional_required": "computed"
													}
												},
												{
													"name": "reason",
													"string": {
														"computed_optional_required": "computed",
														"description": "Cloud-neutral classification of a failure. Present only when there is a diagnosable reason; the raw provider message is never surfaced."
													}
												},
												{
													"name": "state",
													"string": {
														"computed_optional_required": "computed"
													}
												}
											]
										}
									},
									{
										"name": "name",
										"string": {
											"computed_optional_required": "computed",
											"description": "A string that inherits rules from StrictSlug: lowercase letters, digits, hyphens, and underscores, and must start and end with a letter or digit."
										}
									}
								]
							}
						}
					}
				]
			}
		}
	],
