func Create{{.Singular}}(ctx context.Context, provider *client.NumSpotSDK, payload api.Create{{.Singular}}JSONRequestBody{{- if .HasTags}}, tags []api.ResourceTag{{- end}}) (*api.{{.Singular}}, error) {
	spaceID := provider.{{.ScopeID}}
	numspotClient, err := provider.GetClient(ctx)
	if err != nil {
		return nil, err
	}

	var retryCreate *api.Create{{.Singular}}Response
	if retryCreate, err = utils.RetryCreateUntilResourceAvailableWithBody(ctx, spaceID, payload, numspotClient.Create{{.Singular}}WithResponse); err != nil {
		return nil, err
	}

	{{.LocalVar}}ID := *retryCreate.JSON201.Id
	{{- if .HasTags}}

	if len(tags) > 0 {
		if err = createTags(ctx, provider, {{.LocalVar}}ID, tags); err != nil {
			return nil, err
		}
	}
	{{- end}}

	return RetryRead{{.Singular}}(ctx, provider, createOp, {{.LocalVar}}ID)
}
