func Read{{.Singular}}(ctx context.Context, provider *client.NumSpotSDK, id string) (*api.{{.Singular}}, error) {
	numspotClient, err := provider.GetClient(ctx)
	if err != nil {
		return nil, err
	}
	numSpotRead{{.Singular}}, err := numspotClient.Read{{.Plural}}ByIdWithResponse(ctx, provider.{{.ScopeID}}, id)
	if err != nil {
		return nil, err
	}
	if err = utils.ParseHTTPError(numSpotRead{{.Singular}}.Body, numSpotRead{{.Singular}}.StatusCode()); err != nil {
		return nil, err
	}
	return numSpotRead{{.Singular}}.JSON200, nil
}
