func Update{{.Singular}}Tags(ctx context.Context, provider *client.NumSpotSDK, id string, stateTags []api.ResourceTag, planTags []api.ResourceTag) (*api.{{.Singular}}, error) {
	if err := updateResourceTags(ctx, provider, stateTags, planTags, id); err != nil {
		return nil, err
	}
	{{- if .IsAsync}}
	return RetryRead{{.Singular}}(ctx, provider, updateOp, id)
	{{- else}}
	return Read{{.Singular}}(ctx, provider, id)
	{{- end}}
}
