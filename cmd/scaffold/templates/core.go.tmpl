{{- if and .HasResource .IsAsync}}

func RetryRead{{.Singular}}(ctx context.Context, provider *client.NumSpotSDK, _ string, id string) (*api.{{.Singular}}, error) {
	numspotClient, err := provider.GetClient(ctx)
	if err != nil {
		return nil, err
	}
	read, err := utils.RetryReadUntilStateValid(ctx, id, provider.{{.ScopeID}}, {{.LocalVar}}PendingStates, {{.LocalVar}}TargetStates, numspotClient.Read{{.Plural}}ByIdWithResponse)
	if err != nil {
		return nil, err
	}
	result, assert := read.(*api.{{.Singular}})
	if !assert {
		return nil, fmt.Errorf("invalid {{.Name}} assertion %s", id)
	}
	return result, nil
}
{{- end}}

